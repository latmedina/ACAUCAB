<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Orden de Compra</title>
    <style>
        /* Estilos generales del cuerpo del documento */
        body {
            font-family: Arial, sans-serif;
            font-size: 14px;
            color: #333;
            margin: 0;
            padding: 20px;
            background-color: #f4f4f4;
        }

        /* Contenedor principal de la orden de compra */
        .container {
            max-width: 800px;
            margin: auto;
            background-color: #fff;
            padding: 30px;
            border: 1px solid #ccc;
            box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
        }
        
        /* Contenedor principal del encabezado que usa Flexbox */
        .header-section {
            display: flex;
            justify-content: space-between;
            align-items: flex-start; /* Alinea los items al tope */
            margin-bottom: 20px;
        }

        .company-info {
            text-align: left;
        }

        /* Nueva columna derecha que agrupa título y datos de la orden */
        .right-column {
            text-align: right;
        }
        
        .company-info h2 {
            margin-top: 0; /* Asegura que no haya margen superior en ACAUCAB */
        }
        
        /* Estilos para el título principal "ORDEN DE COMPRA" */
        .main-title {
            font-size: 28px;
            font-weight: bold;
            color: #1a237e;
            margin: 0;
            white-space: nowrap;
            margin-bottom: 15px; /* Empuja los campos de abajo para alinear */
        }
        
        /* Información de la empresa y la orden */
        .company-info p, .order-info p {
            margin: 0;
            line-height: 1.8;
        }

        .order-info span {
            display: inline-block;
            border-bottom: 1px solid #333;
            min-width: 100px;
            margin-left: 10px;
        }
        
        .section {
            display: flex;
            justify-content: space-between;
            margin-bottom: 20px;
        }

        /* Contenedor para la información del proveedor */
        .provider-info {
            border: 1px solid #ccc;
            padding: 15px;
            border-radius: 5px;
            display: flex;
            justify-content: space-between;
        }

        .provider-info > div {
            width: 48%;
        }

        .provider-info p {
            margin: 5px 0;
            display: flex;
            justify-content: space-between;
        }
        
        .provider-info span {
            border-bottom: 1px solid #333;
            flex-grow: 1;
            margin-left: 10px;
        }
        
        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 20px;
            font-size: 13px;
        }

        /* --- SECCIÓN DE LA TABLA MODIFICADA --- */
        th, td {
            border: 1px solid #000;
            padding: 5px; /* Relleno reducido para filas más delgadas */
            text-align: left;
        }

        td {
            /* height: 25px; -> Se elimina la altura fija */
        }
        /* --- FIN DE LA SECCIÓN MODIFICADA --- */

        th {
            background-color: #f2f2f2;
            font-weight: bold;
        }

        .col-id { width: 10%; }
        .col-name { width: 45%; }
        .col-qty, .col-price, .col-total { width: 15%; }
        
        .totals-section {
            display: flex;
            justify-content: space-between;
            margin-top: 10px;
        }

        .notes-box {
            border: 1px solid #000;
            padding: 10px;
            width: 50%;
            min-height: 100px;
        }

        .totals-table {
            width: 45%;
            text-align: right;
        }

        .totals-table p {
            margin: 10px 0;
            display: flex;
            justify-content: space-between;
        }
        
        .totals-table span {
            border-bottom: 1px solid #333;
            min-width: 80px;
            text-align: right;
            padding-right: 5px;
        }
        
        .totals-table strong { margin-right: 15px; }

        /* --- SECCIÓN DE FIRMAS MODIFICADA --- */
        .signatures {
            margin-top: 30px; /* Margen superior reducido */
            display: flex;
            justify-content: space-around;
        }
        /* --- FIN DE LA SECCIÓN MODIFICADA --- */
        
        .signature-box {
            text-align: center;
            width: 40%;
        }
        
        .signature-box p {
            border-top: 1px solid #333;
            padding-top: 8px;
            margin-top: 40px;
        }
    </style>
</head>
<body>

    <div class="container">
        <div class="header-section">
            <div class="company-info">
                <h2>ACAUCAB</h2>
                <p>Asociación de Cerveceros Artesanales de la UCAB</p>
                <p>Final Avenida Teherán, Montalbán, Caracas, Distrito Capital, Venezuela.</p>
                <p>Código postal: 1020</p>
                <p>Tlf: 0412-1234567</p>
            </div>
            <div class="right-column">
                <h1 class="main-title">ORDEN DE COMPRA</h1>
                <div class="order-info">
                    <p>Fecha <span contenteditable="true"></span></p>
                    <p>No. de orden <span contenteditable="true"></span></p>
                </div>
            </div>
        </div>
        
        <div class="section provider-info">
            <div class="proveedor">
                <strong>Proveedor</strong>
                <p>Compañía<span contenteditable="true"></span></p>
                <p>Teléfono<span contenteditable="true"></span></p>
                <p>Dirección<span contenteditable="true"></span></p>
            </div>
            <div class="enviar-a">
                <strong>Enviar a</strong>
                <p>Local<span contenteditable="true"></span></p>
                <p>Teléfono<span contenteditable="true"></span></p>
                <p>Dirección<span contenteditable="true"></span></p>
            </div>
        </div>

        <table>
            <thead>
                <tr>
                    <th class="col-id">ID</th>
                    <th class="col-name">Nombre del producto</th>
                    <th class="col-qty">Cantidad</th>
                    <th class="col-price">Precio unitario</th>
                    <th class="col-total">Total</th>
                </tr>
            </thead>
            <tbody>
                <tr><td>&nbsp;</td><td></td><td></td><td></td><td></td></tr>
                <tr><td>&nbsp;</td><td></td><td></td><td></td><td></td></tr>
                <tr><td>&nbsp;</td><td></td><td></td><td></td><td></td></tr>
                <tr><td>&nbsp;</td><td></td><td></td><td></td><td></td></tr>
                <tr><td>&nbsp;</td><td></td><td></td><td></td><td></td></tr>
                <tr><td>&nbsp;</td><td></td><td></td><td></td><td></td></tr>
                <tr><td>&nbsp;</td><td></td><td></td><td></td><td></td></tr>
                <tr><td>&nbsp;</td><td></td><td></td><td></td><td></td></tr>
                <tr><td>&nbsp;</td><td></td><td></td><td></td><td></td></tr>
                <tr><td>&nbsp;</td><td></td><td></td><td></td><td></td></tr>
            </tbody>
        </table>

        <div class="totals-section">
            <div class="notes-box">
                <strong>Notas / Observaciones</strong>
                <div contenteditable="true" style="height: 100%;"></div>
            </div>
            <div class="totals-table">
                <p><strong>SUBTOTAL</strong> <span contenteditable="true"></span></p>
                <p><strong>TASA DE IMPUESTOS</strong> <span contenteditable="true"></span></p>
                <p><strong>TOTAL IMPUESTOS</strong> <span contenteditable="true"></span></p>
                <p><strong>TOTAL</strong> <span contenteditable="true"></span></p>
            </div>
        </div>

        <footer class="signatures">
            <div class="signature-box">
                <p>Autorizado por</p>
            </div>
            <div class="signature-box">
                <p>Firma</p>
            </div>
        </footer>
    </div>

</body>
</html>